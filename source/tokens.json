{
  "$description": "MindFlow design tokens. Primitives are raw values; semantic tokens reference primitives with {path} aliases. Compatible with W3C-style token tooling (Tokens Studio, Style Dictionary).",
  "primitive": {
    "color": {
      "cream": {
        "50": "#FBFAF6",
        "100": "#F8F7F2",
        "200": "#EEF1E8",
        "300": "#E7EBDD",
        "400": "#D9DED2"
      },
      "sage": {
        "100": "#E4EADB",
        "200": "#C8D2BC",
        "300": "#A3B394",
        "500": "#65785B",
        "600": "#506447",
        "700": "#3E5036",
        "800": "#2F3E2A"
      },
      "ink": {
        "900": "#1B231B",
        "800": "#293329",
        "600": "#4F594D",
        "500": "#626B60",
        "400": "#767D72"
      },
      "white": "#FFFFFF",
      "black": "#000000",
      "green": {
        "600": "#426B4A",
        "100": "#DCEADD"
      },
      "amber": {
        "700": "#98652E",
        "600": "#B87A36",
        "100": "#F8E9D2",
        "50": "#FDF5E6"
      },
      "red": {
        "600": "#A3443D",
        "100": "#F5DEDB"
      },
      "teal": {
        "700": "#2C5F6B",
        "600": "#356F7D",
        "100": "#D8EAEE"
      },
      "blue": {
        "600": "#426B78",
        "100": "#DCE9ED"
      },
      "forest": {
        "700": "#355D43"
      }
    }
  },
  "color": {
    "background": {
      "primary": {
        "value": "#F8F7F2",
        "ref": "{primitive.color.cream.100}"
      },
      "secondary": {
        "value": "#EEF1E8",
        "ref": "{primitive.color.cream.200}"
      },
      "inverse": {
        "value": "#293329",
        "ref": "{primitive.color.ink.800}"
      }
    },
    "surface": {
      "default": {
        "value": "#FFFFFF",
        "ref": "{primitive.color.white}"
      },
      "subtle": {
        "value": "#E7EBDD",
        "ref": "{primitive.color.cream.300}"
      },
      "selected": {
        "value": "#E4EADB",
        "ref": "{primitive.color.sage.100}"
      },
      "completed": {
        "value": "#EEF1E8",
        "ref": "{primitive.color.cream.200}"
      },
      "disabled": {
        "value": "#E7EBDD",
        "ref": "{primitive.color.cream.300}"
      }
    },
    "brand": {
      "primary": {
        "value": "#506447",
        "ref": "{primitive.color.sage.600}",
        "note": "Darkened from the #65785B starting token so white text on primary buttons reaches 6.4:1. #65785B is kept as brand.accent for large decorative use."
      },
      "primaryHover": {
        "value": "#3E5036",
        "ref": "{primitive.color.sage.700}"
      },
      "primaryPressed": {
        "value": "#2F3E2A",
        "ref": "{primitive.color.sage.800}"
      },
      "accent": {
        "value": "#65785B",
        "ref": "{primitive.color.sage.500}"
      },
      "secondary": {
        "value": "#C8D2BC",
        "ref": "{primitive.color.sage.200}"
      },
      "onPrimary": {
        "value": "#FFFFFF",
        "ref": "{primitive.color.white}"
      }
    },
    "text": {
      "primary": {
        "value": "#293329",
        "ref": "{primitive.color.ink.800}"
      },
      "secondary": {
        "value": "#4F594D",
        "ref": "{primitive.color.ink.600}",
        "note": "Darkened from #626B60 for AA on all backgrounds (7.3:1 on primary background)."
      },
      "muted": {
        "value": "#626B60",
        "ref": "{primitive.color.ink.500}",
        "note": "Muted metadata only. 4.9:1 on background.primary."
      },
      "disabled": {
        "value": "#767D72",
        "ref": "{primitive.color.ink.400}"
      },
      "onInverse": {
        "value": "#F8F7F2",
        "ref": "{primitive.color.cream.100}"
      },
      "link": {
        "value": "#2C5F6B",
        "ref": "{primitive.color.teal.700}"
      }
    },
    "border": {
      "default": {
        "value": "#D9DED2",
        "ref": "{primitive.color.cream.400}"
      },
      "strong": {
        "value": "#8A9484",
        "note": "Form-control and toggle outlines (3.3:1 on white)."
      },
      "selected": {
        "value": "#506447",
        "ref": "{primitive.color.sage.600}"
      }
    },
    "feedback": {
      "success": {
        "value": "#426B4A",
        "ref": "{primitive.color.green.600}"
      },
      "successSurface": {
        "value": "#DCEADD",
        "ref": "{primitive.color.green.100}"
      },
      "warning": {
        "value": "#98652E",
        "ref": "{primitive.color.amber.700}"
      },
      "warningSurface": {
        "value": "#F8E9D2",
        "ref": "{primitive.color.amber.100}"
      },
      "error": {
        "value": "#A3443D",
        "ref": "{primitive.color.red.600}"
      },
      "errorSurface": {
        "value": "#F5DEDB",
        "ref": "{primitive.color.red.100}"
      },
      "info": {
        "value": "#426B78",
        "ref": "{primitive.color.blue.600}"
      },
      "infoSurface": {
        "value": "#DCE9ED",
        "ref": "{primitive.color.blue.100}"
      },
      "warningText": {
        "value": "#6F4519",
        "note": "Text on warningSurface and timer.expiredSurface. 7.2:1."
      }
    },
    "focus": {
      "ring": {
        "value": "#355D43",
        "ref": "{primitive.color.forest.700}"
      },
      "halo": {
        "value": "#FFFFFF",
        "ref": "{primitive.color.white}"
      }
    },
    "state": {
      "hover": {
        "value": "#EEF1E8"
      },
      "pressed": {
        "value": "#E4EADB"
      },
      "disabled": {
        "value": "#E7EBDD"
      },
      "selected": {
        "value": "#E4EADB"
      },
      "completed": {
        "value": "#EEF1E8"
      }
    },
    "timer": {
      "running": {
        "value": "#2C5F6B",
        "ref": "{primitive.color.teal.700}"
      },
      "runningSurface": {
        "value": "#D8EAEE",
        "ref": "{primitive.color.teal.100}"
      },
      "paused": {
        "value": "#4F594D",
        "ref": "{primitive.color.ink.600}"
      },
      "pausedSurface": {
        "value": "#E7EBDD",
        "ref": "{primitive.color.cream.300}"
      },
      "expired": {
        "value": "#98652E",
        "ref": "{primitive.color.amber.700}"
      },
      "expiredSurface": {
        "value": "#F8E9D2",
        "ref": "{primitive.color.amber.100}"
      }
    }
  },
  "theme": {
    "light": {
      "$description": "Default theme. Uses the color.* semantic tokens above."
    },
    "highContrast": {
      "color.background.primary": "#FFFFFF",
      "color.background.secondary": "#F2F2F2",
      "color.surface.default": "#FFFFFF",
      "color.surface.subtle": "#EDEDED",
      "color.brand.primary": "#1F3A1A",
      "color.brand.primaryHover": "#142610",
      "color.text.primary": "#000000",
      "color.text.secondary": "#1A1A1A",
      "color.text.muted": "#333333",
      "color.border.default": "#4A4A4A",
      "color.focus.ring": "#0B3D91",
      "color.timer.running": "#0B3D5C",
      "color.timer.expired": "#6B3F00"
    }
  },
  "font": {
    "family": {
      "primary": "Inter, system-ui, -apple-system, 'Segoe UI', sans-serif",
      "accessible": "'Atkinson Hyperlegible', Inter, system-ui, sans-serif"
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    }
  },
  "typography": {
    "display": {
      "size": "clamp(2.5rem, 5vw, 3rem)",
      "sizeRange": "40-48px",
      "weight": 700,
      "lineHeight": 1.15,
      "letterSpacing": "-0.02em"
    },
    "heading1": {
      "size": "2rem",
      "sizePx": 32,
      "weight": 600,
      "lineHeight": 1.25
    },
    "heading2": {
      "size": "1.5rem",
      "sizePx": 24,
      "weight": 600,
      "lineHeight": 1.3
    },
    "heading3": {
      "size": "1.25rem",
      "sizePx": 20,
      "weight": 600,
      "lineHeight": 1.4
    },
    "bodyLarge": {
      "size": "1.125rem",
      "sizePx": 18,
      "weight": 400,
      "lineHeight": 1.6
    },
    "body": {
      "size": "1rem",
      "sizePx": 16,
      "weight": 400,
      "lineHeight": 1.6
    },
    "supporting": {
      "size": "0.875rem",
      "sizePx": 14,
      "weight": 500,
      "lineHeight": 1.5
    },
    "label": {
      "size": "0.8125rem",
      "sizePx": 13,
      "weight": 500,
      "lineHeight": 1.4,
      "letterSpacing": "0.01em"
    },
    "cookingInstruction": {
      "size": "clamp(1.25rem, 2.2vw, 1.625rem)",
      "sizeRangePx": "20-26",
      "weight": 500,
      "lineHeight": 1.6
    },
    "timerDigits": {
      "size": "2.5rem",
      "sizePx": 40,
      "weight": 700,
      "lineHeight": 1,
      "fontFeature": "tabular-nums"
    },
    "measure": {
      "readingWidth": "65ch"
    }
  },
  "spacing": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px",
    "16": "64px",
    "20": "80px"
  },
  "size": {
    "touchTarget": "48px",
    "touchTargetComfortable": "56px",
    "containerMax": "1120px",
    "containerReading": "65ch",
    "gutterMobile": "16px",
    "gutterTablet": "24px",
    "gutterDesktop": "32px"
  },
  "radius": {
    "none": "0px",
    "small": "8px",
    "medium": "12px",
    "large": "20px",
    "pill": "999px"
  },
  "border": {
    "width": {
      "thin": "1px",
      "medium": "2px",
      "thick": "3px"
    }
  },
  "shadow": {
    "none": "none",
    "low": "0 1px 2px rgba(41,51,41,0.06), 0 1px 1px rgba(41,51,41,0.04)",
    "medium": "0 4px 12px rgba(41,51,41,0.08), 0 1px 3px rgba(41,51,41,0.06)",
    "high": "0 12px 32px rgba(41,51,41,0.14), 0 2px 6px rgba(41,51,41,0.08)",
    "dock": "0 -4px 20px rgba(41,51,41,0.10)"
  },
  "focus": {
    "ringWidth": "3px",
    "ringOffset": "2px",
    "ringStyle": "solid",
    "css": "outline: 3px solid #355D43; outline-offset: 2px; box-shadow: 0 0 0 5px #FFFFFF;"
  },
  "breakpoint": {
    "mobile": {
      "max": "599px",
      "columns": 4,
      "margin": "16px",
      "gutter": "16px"
    },
    "tablet": {
      "min": "600px",
      "max": "1024px",
      "columns": 8,
      "margin": "24px",
      "gutter": "24px"
    },
    "desktop": {
      "min": "1025px",
      "columns": 12,
      "margin": "32px",
      "gutter": "32px"
    }
  },
  "motion": {
    "duration": {
      "instant": "0ms",
      "fast": "120ms",
      "normal": "200ms",
      "slow": "320ms"
    },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)"
    },
    "reducedMotion": "All durations resolve to 0ms and non-essential transitions are removed when prefers-reduced-motion or the in-app setting is on."
  },
  "component": {
    "button": {
      "primary": {
        "default": {
          "background": "{color.brand.primary}",
          "text": "{color.brand.onPrimary}",
          "height": "56px",
          "radius": "{radius.medium}"
        },
        "hover": {
          "background": "{color.brand.primaryHover}"
        },
        "pressed": {
          "background": "{color.brand.primaryPressed}"
        },
        "focused": {
          "outline": "{focus.css}"
        },
        "disabled": {
          "background": "{color.surface.disabled}",
          "text": "{color.text.disabled}"
        },
        "loading": {
          "background": "{color.brand.primary}",
          "indicator": "spinner (static dots when reduced motion)"
        }
      },
      "secondary": {
        "default": {
          "background": "{color.surface.default}",
          "border": "2px solid {color.brand.primary}",
          "text": "{color.brand.primary}"
        },
        "hover": {
          "background": "{color.state.hover}"
        },
        "pressed": {
          "background": "{color.state.pressed}"
        }
      }
    },
    "ingredientRow": {
      "default": {
        "background": "{color.surface.default}",
        "minHeight": "56px"
      },
      "hover": {
        "background": "{color.state.hover}"
      },
      "focus": {
        "outline": "{focus.css}"
      },
      "checked": {
        "text": "{color.text.secondary}",
        "textDecoration": "line-through",
        "checkbox": "filled with check icon"
      },
      "completedCollapsed": {
        "background": "{color.state.completed}",
        "group": "Ready"
      }
    },
    "stepperCard": {
      "standard": {},
      "withIngredients": {},
      "withTimer": {},
      "withSafetyNote": {
        "noteBackground": "{color.feedback.warningSurface}",
        "noteIcon": "warning triangle + text label"
      },
      "completed": {
        "badge": "Done check + label"
      }
    },
    "timer": {
      "idle": {
        "label": "Start {n} min timer",
        "accent": "{color.brand.primary}"
      },
      "running": {
        "accent": "{color.timer.running}",
        "surface": "{color.timer.runningSurface}",
        "controls": [
          "Pause"
        ]
      },
      "paused": {
        "accent": "{color.timer.paused}",
        "surface": "{color.timer.pausedSurface}",
        "controls": [
          "Resume",
          "Reset"
        ]
      },
      "completed": {
        "accent": "{color.timer.expired}",
        "surface": "{color.timer.expiredSurface}",
        "controls": [
          "Dismiss"
        ],
        "label": "Time's up"
      },
      "dismissed": {
        "visible": false
      }
    },
    "recipeCard": {
      "default": {},
      "hover": {
        "shadow": "{shadow.medium}"
      },
      "focus": {
        "outline": "{focus.css}"
      },
      "saved": {
        "icon": "filled bookmark + 'Saved' label"
      },
      "continueCooking": {
        "badge": "Step n of m"
      }
    },
    "progress": {
      "notStarted": {
        "fill": "{color.surface.subtle}"
      },
      "inProgress": {
        "fill": "{color.brand.primary}"
      },
      "completed": {
        "fill": "{color.feedback.success}",
        "icon": "check"
      }
    },
    "toggle": {
      "on": {
        "track": "{color.brand.primary}",
        "label": "On"
      },
      "off": {
        "track": "#8A9484",
        "label": "Off"
      },
      "focused": {
        "outline": "{focus.css}"
      },
      "disabled": {
        "track": "{color.surface.disabled}"
      }
    }
  },
  "figma": {
    "variableCollections": [
      {
        "name": "Primitives",
        "modes": [
          "Value"
        ],
        "source": "primitive.color.*"
      },
      {
        "name": "Semantic Color",
        "modes": [
          "Light",
          "High Contrast"
        ],
        "source": "color.* and theme.highContrast"
      },
      {
        "name": "Spacing",
        "modes": [
          "Value"
        ],
        "source": "spacing.*"
      },
      {
        "name": "Radius",
        "modes": [
          "Value"
        ],
        "source": "radius.*"
      },
      {
        "name": "Breakpoints",
        "modes": [
          "Mobile",
          "Tablet",
          "Desktop"
        ],
        "source": "breakpoint.*"
      }
    ],
    "pages": [
      "Foundations",
      "Components",
      "Desktop Screens",
      "Mobile Screens",
      "Prototype Flow"
    ]
  }
}